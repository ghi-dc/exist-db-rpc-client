{
    "name": "ghi-dc/exist-db-rpc-client",
    "type": "library",
    "description": "A client for querying and transforming results from eXist-db via XML RPC",
    "keywords": [
        "eXist-db",
        "xquery",
        "xslt",
        "php",
        "xmlrpc"
    ],
    "homepage": "https://github.com/ghi-dc/exist-db-rpc-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Burckhardt",
            "email": "burckhardt@ghi-dc.org"
        }
    ],
    "require": {
        "lstrojny/fxmlrpc": "dev-master",
        "php-http/message": "^1.16",
        "php-http/guzzle7-adapter": "^1.1",
        "guzzlehttp/psr7": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "ExistDbRpc\\": "src"
        }
    },
    "minimum-stability": "stable"
}
